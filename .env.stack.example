# Copy this to `.env.stack` and replace every secret placeholder.
MODEL_ROUTER_DATA_DIR=./runtime/model-router
OPEN_WEBUI_DATA_DIR=./runtime/open-webui
HERMES_HOME=./runtime/hermes
MODEL_ROUTER_DATABASE_URL=postgresql+psycopg://openwebui:openwebui@db:5432/model_router
MODEL_ROUTER_DATABASE_AUTO_CREATE=false
MODEL_ROUTER_PORT=4000
OPEN_WEBUI_PORT=3002
LLAMA_PORT=8081
MODEL_ROUTER_ENV=production
MODEL_ROUTER_JWT_SECRET_KEY=replace-with-a-long-random-secret
MODEL_ROUTER_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
MODEL_ROUTER_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password
MODEL_ROUTER_BOOTSTRAP_TENANT_NAME=Default Tenant
MODEL_ROUTER_BOOTSTRAP_TENANT_SLUG=default

# Generate separate scoped keys for each service.
OPEN_WEBUI_ROUTER_API_KEY=replace-with-generated-openwebui-key
AGENT_CONSOLE_API_KEY=replace-with-generated-console-key
MODEL_ROUTER_RUNNER_API_KEY=replace-with-generated-runner-key
# Seed these with keys generated by the router; placeholders are intentionally invalid.
MODEL_ROUTER_BOOTSTRAP_API_KEYS_JSON=[]
# Safe local routes; add cloud routes and headers only through a secret-managed override.
MODEL_ROUTER_BOOTSTRAP_ROUTES_JSON=[{"name":"hermes-agent","description":"Hermes API server","upstream_base_url":"http://hermes:8642/v1","upstream_model_name":"hermes-agent","allowed_tenant_slugs":["default"]},{"name":"functiongemma-270m-it-Q4_K_M.gguf","description":"FunctionGemma tool-calling model","upstream_base_url":"managed://llama-server","upstream_model_name":"functiongemma-270m-it-Q4_K_M.gguf","allowed_tenant_slugs":["default"],"max_context_tokens":32768},{"name":"gemma-4-31B-it-qat-UD-Q4_K_XL.gguf","description":"Gemma 4 local model","upstream_base_url":"managed://llama-server","upstream_model_name":"gemma-4-31B-it-qat-UD-Q4_K_XL.gguf","allowed_tenant_slugs":["default"],"max_context_tokens":192000},{"name":"local/qwen-reasoning","description":"Qwen3.6 Q4 reasoning model","upstream_base_url":"managed://llama-server","upstream_model_name":"local-qwen-reasoning","allowed_tenant_slugs":["default"],"max_context_tokens":262144,"capabilities":{"streaming":true,"reasoning":true,"tools":true,"local":true,"kv_cache":"turbo4/turbo3"}}]
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
OPEN_WEBUI_PATCHED_IMAGE=open-webui-router:local
OPENWEBUI_INLINE_FULL_CONTEXT_MAX_CHARS=16000

HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_UID=1000
HERMES_GID=1000
HERMES_API_MODEL_NAME=hermes-agent
LLAMA_CPP_IMAGE=vito974/llama-cpp-turboquant:server-cuda12
LLAMA_CACHE_DIR=./runtime/llama-cpp
LLAMA_HF_REPO=unsloth/gemma-4-31B-it-qat-GGUF:UD-Q4_K_XL
LLAMA_SPEC_TYPE=none
LLAMA_CTX_SIZE=192000
LLAMA_CACHE_TYPE_K=turbo4
LLAMA_CACHE_TYPE_V=turbo3
LLAMA_BATCH_SIZE=2048
LLAMA_UBATCH_SIZE=512
LLAMA_THREADS=8
LLAMA_N_CPU_MOE=0

ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://searxng:8080
SEARXNG_PORT=8088
WEBUI_SECRET_KEY=replace-with-a-long-random-string

# Cloud Google OAuth project credentials.
MODEL_ROUTER_GOOGLE_OAUTH_CLIENT_ID=
MODEL_ROUTER_GOOGLE_OAUTH_CLIENT_SECRET=
MODEL_ROUTER_GOOGLE_OAUTH_REDIRECT_URI=https://router.example.com/api/v1/integrations/google/callback
MODEL_ROUTER_GOOGLE_OAUTH_ENCRYPTION_KEY=generate-a-fernet-key

# Optional self-hosted OTLP collector.
MODEL_ROUTER_OTEL_ENABLED=false
MODEL_ROUTER_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
